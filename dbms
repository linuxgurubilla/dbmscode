-- BEFORE INSERT: reduce salary by 400 for the new row if perks > 500
-- (MySQL cannot UPDATE the same table inside its own trigger, so NEW.salary is changed)
DELIMITER $$
CREATE TRIGGER inst_trigger BEFORE INSERT ON employee
FOR EACH ROW
BEGIN
  IF NEW.perks > 500 THEN
    SET NEW.salary = NEW.salary - 400;
  END IF;
END$$
DELIMITER ;

INSERT INTO employee VALUES (5, 'mike', 'chennai', 'developer', 15500, 840);
SELECT * FROM employee;                  -- mike's salary is 15100

-- BEFORE UPDATE
DELIMITER //
CREATE TRIGGER updtrigger BEFORE UPDATE ON employee
FOR EACH ROW
BEGIN
  IF NEW.salary = 500 THEN
    SET NEW.salary = 10000;
  ELSEIF NEW.salary > 500 THEN
    SET NEW.salary = 15000;
  END IF;
END//
DELIMITER ;

UPDATE employee SET salary
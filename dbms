-- EX. NO: 9   USER DEFINED FUNCTIONS
-- (The manual code is SQL Server / T-SQL. It does not run in MySQL.
--  MySQL version below. MySQL has no table-valued functions, so those two
--  are written as stored procedures that return a result set.)
-- ############################################################################
DROP DATABASE IF EXISTS ex9;
CREATE DATABASE ex9;
USE ex9;

-- 1. Scalar user defined function
DELIMITER $$
CREATE FUNCTION SquareNumber(num INT)
RETURNS INT
DETERMINISTIC
BEGIN
  RETURN num * num;
END$$
DELIMITER ;

SELECT SquareNumber(5) AS Result;

-- 2. "Table-valued" function  (procedure returning rows)
CREATE TABLE Employees (EmployeeID INT PRIMARY KEY, Name VARCHAR(50), Salary DECIMAL(10,2));
INSERT INTO Employees VALUES
  (101, 'Ravi',  60000),
  (102, 'Priya', 75000),
  (103, 'Kumar', 45000),
  (104, 'Anu',   30000);

DELIMITER $$
CREATE PROCEDURE GetHighPaidEmployees(IN min_salary DECIMAL(10,2))
BEGIN
  SELECT EmployeeID AS Emp_id, Name AS Emp_name, Salary
  FROM Employees
  WHERE Salary > min_salary;
END$$
DELIMITER ;

CALL GetHighPaidEmployees(50000);

-- 3. "Multi-statement table-valued function"  (procedure with loop)
DELIMITER $$
CREATE PROCEDURE GenerateSquares(IN max_number INT)
BEGIN
  DECLARE i INT DEFAULT 1;
  DROP TEMPORARY TABLE IF EXISTS tmp_squares;
  CREATE TEMPORARY TABLE tmp_squares (num INT, square INT);
  WHILE i <= max_number DO
    INSERT INTO tmp_squares (num, square) VALUES (i, i * i);
    SET i = i + 1;
  END WHILE;
  SELECT num AS `NUMBER`, square AS `SQUARE` FROM tmp_squares;
  DROP TEMPORARY TABLE tmp_squares;
END$$
DELIMITER ;

CALL GenerateSquares(5);



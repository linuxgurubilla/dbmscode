-- Arithmetic operators
CREATE TABLE numbers (num1 INT, num2 INT);
INSERT INTO numbers (num1, num2) VALUES (5, 10), (15, 20);

SELECT num1, num2, num1 + num2 AS `sum`        FROM numbers;   -- 1. Addition
SELECT num1, num2, num1 - num2 AS difference   FROM numbers;   -- 2. Subtraction
SELECT num1, num2, num1 * num2 AS product      FROM numbers;   -- 3. Multiplication
SELECT num1, num2, num1 / num2 AS quotient     FROM numbers;   -- 4. Division
SELECT num1, num2, POW(num1, 2) AS power_of_2  FROM numbers;   -- 5. Power (in MySQL ^ is XOR, so use POW())
SELECT num1, num2, num1 % num2 AS remainder    FROM numbers;   -- 6. Modulus

-- Logical and comparison operators
